generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── USUÁRIO ───────────────────────────────────────────────────────────────

model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  password        String
  avatar          String?
  experienceLevel ExperienceLevel @default(INICIANTE)
  learningStyle   LearningStyle   @default(LEITURA)
  dailyStudyHours Float           @default(2)
  examDate        DateTime?
  examName        String?
  targetRole      String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relações
  routines              Routine[]
  subjects              Subject[]
  studyPlans            StudyPlan[]
  studySessions         StudySession[]
  goals                 Goal[]
  flashcards            Flashcard[]
  flashcardFolders      FlashcardFolder[]
  questions             Question[]
  questionAttempts      QuestionAttempt[]
  questionFavorites     QuestionFavorite[]
  questionComments      QuestionComment[]
  questionAnnotations   QuestionAnnotation[]
  notebookFolders       QuestionNotebookFolder[]
  questionReviews       QuestionReview[]
  questionTexts         QuestionText[]
  questionReports       QuestionReport[]
  commentLikes          QuestionCommentLike[]
  studyEditais          StudyEdital[]
  lawHighlights         LawHighlight[]
  examAttempts          ExamAttempt[]
  examsCreated          Exam[]
  studyCycles           StudyCycle[]
  studyTimeLogs         StudyTimeLog[]
  subscriptions         Subscription[]
  orders                Order[]
  questionNotebooks     QuestionNotebook[]
  notes                 Note[]
  mindMaps              MindMap[]
  errorNotebook         ErrorEntry[]
  questionLogs          QuestionLog[]
  habits                Habit[]
  gamification          Gamification?
  notifications         Notification[]
  pdfs                  PDF[]
  focusSessions         FocusSession[]
  emotionLogs           EmotionLog[]
  // Inteligência adaptativa
  brainProfile          BrainProfile?
  behaviorEvents        BehaviorEvent[]
  energyLogs            EnergyLog[]
  dailyPlans            DailyIntelligencePlan[]
  missions              Mission[]
  bruteForce            BruteForceSession[]
  procrastinationEvents ProcrastinationEvent[]
  analysisInsights      AnalysisInsight[]
  // Mentoria
  mentorProfile         Mentor?
  studentMentorings     Mentoring[]              @relation("StudentMentorings")
  sentMessages          MentoringMessage[]       @relation("SentMessages")
  // Edital
  editalImports         EditalImport[]
  // Desafio Diário
  dailyChallenges       DailyChallenge[]
  // Redação / Professor
  role                  UserRole                 @default(STUDENT)
  essays                Essay[]                  @relation("StudentEssays")
  corrections           EssayCorrection[]        @relation("TeacherCorrections")
  essayComments         EssayComment[]           @relation("EssayCommentAuthor")
  teacherStudents       TeacherStudent[]         @relation("TeacherStudents")
  studentTeachers       TeacherStudent[]         @relation("StudentTeachers")
  sentInvites           TeacherInvite[]          @relation("StudentInvites")
  usedInvites           TeacherInvite[]          @relation("TeacherUsedInvites")
  feedbackTemplates     FeedbackTemplate[]

  @@map("users")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum ExperienceLevel {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

enum LearningStyle {
  VISUAL
  LEITURA
  PRATICA
  AUDITIVO
}

// ─── ROTINA ────────────────────────────────────────────────────────────────

model Routine {
  id        String      @id @default(uuid())
  userId    String
  dayOfWeek Int // 0=Domingo ... 6=Sábado
  startTime String // "08:00"
  endTime   String // "12:00"
  type      RoutineType
  label     String?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("routines")
}

enum RoutineType {
  ESTUDO
  TRABALHO
  LIVRE
  SONO
}

// ─── DISCIPLINAS ───────────────────────────────────────────────────────────

model Subject {
  id          String   @id @default(uuid())
  userId      String
  name        String
  color       String   @default("#1976d2")
  icon        String?
  weight      Float    @default(1.0) // Peso/prioridade no cronograma
  totalTopics Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules         Module[]
  errorEntries    ErrorEntry[]
  questionLogs    QuestionLog[]
  pdfs            PDF[]
  flashcards      Flashcard[]
  dailyChallenges DailyChallenge[]
  questions       Question[]

  @@map("subjects")
}

model Module {
  id        String   @id @default(uuid())
  subjectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@map("modules")
}

model Topic {
  id             String     @id @default(uuid())
  moduleId       String
  name           String
  order          Int        @default(0)
  difficulty     Difficulty @default(MEDIO)
  estimatedHours Float      @default(1)
  progress       Float      @default(0) // 0-100%
  isCompleted    Boolean    @default(false)
  lastStudiedAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  module       Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  studyTasks   StudyTask[]
  errorEntries ErrorEntry[]
  flashcards   Flashcard[]
  questionLogs QuestionLog[]
  pdfs         PDF[]
  notes        Note[]

  @@map("topics")
}

enum Difficulty {
  FACIL
  MEDIO
  DIFICIL
}

// ─── PLANO DE ESTUDOS ──────────────────────────────────────────────────────

model StudyPlan {
  id        String     @id @default(uuid())
  userId    String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean    @default(true)
  status    PlanStatus @default(ATIVO)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks StudyTask[]

  @@map("study_plans")
}

enum PlanStatus {
  ATIVO
  PAUSADO
  CONCLUIDO
  ATRASADO
}

model StudyTask {
  id               String    @id @default(uuid())
  studyPlanId      String
  topicId          String?
  title            String
  description      String?
  scheduledDate    DateTime
  estimatedMinutes Int       @default(60)
  actualMinutes    Int?
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  order            Int       @default(0)
  type             TaskType  @default(LEITURA)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studyPlan     StudyPlan      @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  topic         Topic?         @relation(fields: [topicId], references: [id])
  focusSessions FocusSession[]

  @@map("study_tasks")
}

enum TaskType {
  LEITURA
  REVISAO
  EXERCICIOS
  VIDEO
  RESUMO
  FLASHCARDS
  SIMULADO
}

// ─── SESSÃO DE ESTUDOS ─────────────────────────────────────────────────────

model StudySession {
  id           String   @id @default(uuid())
  userId       String
  date         DateTime
  totalMinutes Int
  notes        String?
  mood         Int? // 1-5
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_sessions")
}

// ─── MODO FOCO (POMODORO) ──────────────────────────────────────────────────

model FocusSession {
  id           String         @id @default(uuid())
  userId       String
  studyTaskId  String?
  technique    FocusTechnique @default(POMODORO)
  workMinutes  Int            @default(25)
  breakMinutes Int            @default(5)
  cycles       Int            @default(0)
  totalMinutes Int            @default(0)
  status       FocusStatus    @default(ATIVO)
  startedAt    DateTime       @default(now())
  endedAt      DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyTask StudyTask? @relation(fields: [studyTaskId], references: [id])

  @@map("focus_sessions")
}

enum FocusTechnique {
  POMODORO
  FLOWTIME
  CINQUENTA_DEZ
  NOVENTA_VINTE
}

enum FocusStatus {
  ATIVO
  PAUSADO
  CONCLUIDO
  CANCELADO
}

// ─── METAS ─────────────────────────────────────────────────────────────────

model Goal {
  id          String     @id @default(uuid())
  userId      String
  title       String
  type        GoalType
  period      GoalPeriod
  target      Float
  current     Float      @default(0)
  unit        String // "horas", "questões", "tópicos"
  startDate   DateTime
  endDate     DateTime
  isCompleted Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

enum GoalType {
  TEMPO
  QUESTOES
  TOPICOS
  REVISOES
}

enum GoalPeriod {
  DIARIO
  SEMANAL
  MENSAL
}

// ─── FLASHCARDS ────────────────────────────────────────────────────────────

model FlashcardFolder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#6C63FF")
  icon      String   @default("folder")
  parentId  String?
  createdAt DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent     FlashcardFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children   FlashcardFolder[] @relation("FolderTree")
  flashcards Flashcard[]

  @@map("flashcard_folders")
}

model Flashcard {
  id             String     @id @default(uuid())
  userId         String
  folderId       String?
  subjectId      String?
  topicId        String?
  front          String     @db.Text
  back           String     @db.Text
  difficulty     Difficulty @default(MEDIO)
  nextReviewAt   DateTime   @default(now())
  interval       Int        @default(1)
  easeFactor     Float      @default(2.5)
  repetitions    Int        @default(0)
  totalReviews   Int        @default(0)
  correctReviews Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder  FlashcardFolder?  @relation(fields: [folderId], references: [id])
  subject Subject?          @relation(fields: [subjectId], references: [id])
  topic   Topic?            @relation(fields: [topicId], references: [id])
  reviews FlashcardReview[]

  @@map("flashcards")
}

model FlashcardReview {
  id          String   @id @default(uuid())
  flashcardId String
  rating      Int // 0=Errou, 1=Difícil, 2=Ok, 3=Fácil
  reviewedAt  DateTime @default(now())

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@map("flashcard_reviews")
}

// ─── ANOTAÇÕES ─────────────────────────────────────────────────────────────

model Note {
  id        String   @id @default(uuid())
  userId    String
  topicId   String?
  title     String
  content   String   @db.LongText
  tags      String? // JSON array
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic? @relation(fields: [topicId], references: [id])

  @@map("notes")
}

// ─── MAPAS MENTAIS ─────────────────────────────────────────────────────────

model MindMap {
  id        String   @id @default(uuid())
  userId    String
  title     String
  data      Json // estrutura de nós do mapa mental
  thumbnail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mind_maps")
}

// ─── PDFs ──────────────────────────────────────────────────────────────────

model PDF {
  id          String   @id @default(uuid())
  userId      String
  subjectId   String?
  topicId     String?
  title       String
  filename    String
  path        String
  size        Int
  pageCount   Int?
  currentPage Int      @default(1)
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])
  topic   Topic?   @relation(fields: [topicId], references: [id])

  @@map("pdfs")
}

// ─── CADERNO DE ERROS ──────────────────────────────────────────────────────

model ErrorEntry {
  id                 String     @id @default(uuid())
  userId             String
  questionId         String? // questão do banco que originou o erro (registro automático)
  subjectId          String
  topicId            String?
  title              String?
  questionText       String?    @db.Text
  description        String     @db.Text
  correctAnswer      String     @db.Text
  myAnswer           String?    @db.Text
  explanation        String?    @db.Text
  personalNotes      String?    @db.Text
  source             String?
  errorType          ErrorType
  difficulty         Difficulty @default(MEDIO)
  imageUrl           String?
  audioUrl           String?
  audioTranscription String?    @db.Text
  nextReviewAt       DateTime   @default(now())
  reviewCount        Int        @default(0)
  isResolved         Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject       @relation(fields: [subjectId], references: [id])
  topic    Topic?        @relation(fields: [topicId], references: [id])
  reviews  ErrorReview[]
  question Question?     @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([userId, questionId])
  @@map("error_entries")
}

model ErrorReview {
  id           String       @id @default(uuid())
  errorEntryId String
  result       ReviewResult
  reviewedAt   DateTime     @default(now())

  errorEntry ErrorEntry @relation(fields: [errorEntryId], references: [id], onDelete: Cascade)

  @@map("error_reviews")
}

enum ErrorType {
  FALTA_ATENCAO
  CONTEUDO_NAO_ESTUDADO
  INTERPRETACAO
  ESQUECIMENTO
}

enum ReviewResult {
  ACERTOU
  ERROU_NOVAMENTE
  PARCIALMENTE
}

// ─── QUESTÕES ──────────────────────────────────────────────────────────────

model Question {
  id          String       @id @default(uuid())
  userId      String // autor (admin = banco público; aluno = questão privada)
  subjectId   String?
  textId      String? // texto de apoio compartilhado (ex.: "Texto I" de Português)
  assuntoId   Int? // nó da árvore de matérias/assuntos (qualquer nível)
  type        QuestionType @default(MULTIPLA_ESCOLHA)
  statement   String       @db.Text
  optionA     String?      @db.Text
  optionB     String?      @db.Text
  optionC     String?      @db.Text
  optionD     String?      @db.Text
  optionE     String?      @db.Text
  answer      String? // "A".."E" (múltipla escolha) | "C"/"E" (certo/errado) — null se sem gabarito
  explanation String?      @db.Text
  discipline  String? // disciplina no banco compartilhado (ex.: Direito Constitucional)
  topic       String? // assunto
  banca       String?
  orgao       String?
  cargo       String?
  year        Int?
  level       String? // escolaridade: FUNDAMENTAL | MEDIO | SUPERIOR
  source      String? // nome do PDF/livro/prova
  difficulty  Difficulty   @default(MEDIO)
  isPublic    Boolean      @default(false)
  isAnnulled  Boolean      @default(false)
  isOutdated  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  attempts      QuestionAttempt[]
  favorites     QuestionFavorite[]
  comments      QuestionComment[]
  annotations   QuestionAnnotation[]
  notebookItems NotebookQuestion[]
  text          QuestionText?        @relation(fields: [textId], references: [id], onDelete: SetNull)
  assunto       Assunto?             @relation(fields: [assuntoId], references: [id], onDelete: SetNull)
  reports       QuestionReport[]
  reviews       QuestionReview[]
  errorEntries  ErrorEntry[]
  lawLinks      QuestionLawLink[]
  examItems     ExamQuestion[]

  @@index([isPublic, discipline])
  @@index([assuntoId])
  @@index([textId])
  @@index([userId])
  @@index([banca])
  @@map("questions")
}

enum QuestionType {
  MULTIPLA_ESCOLHA
  CERTO_ERRADO
}

model QuestionAttempt {
  id         String   @id @default(uuid())
  questionId String
  userId     String
  notebookId String? // resolvida dentro de um caderno
  selected   String // letra escolhida
  isCorrect  Boolean
  timeSpent  Int?
  createdAt  DateTime @default(now())

  question Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook QuestionNotebook? @relation(fields: [notebookId], references: [id], onDelete: SetNull)

  @@index([userId, questionId])
  @@index([notebookId])
  @@map("question_attempts")
}

model QuestionFavorite {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("question_favorites")
}

// Riscos de caneta/marca-texto do aluno sobre a questão
model QuestionAnnotation {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  strokes    Json
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("question_annotations")
}

// ─── CADERNOS DE QUESTÕES ──────────────────────────────────────────────────

model QuestionNotebookFolder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#F2B705")
  createdAt DateTime @default(now())

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebooks QuestionNotebook[]

  @@index([userId])
  @@map("question_notebook_folders")
}

model QuestionNotebook {
  id          String   @id @default(uuid())
  userId      String
  folderId    String?
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder   QuestionNotebookFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  items    NotebookQuestion[]
  attempts QuestionAttempt[]

  @@index([userId, folderId])
  @@map("question_notebooks")
}

model NotebookQuestion {
  id         String   @id @default(uuid())
  notebookId String
  questionId String
  position   Int      @default(0)
  addedAt    DateTime @default(now())

  notebook QuestionNotebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  question Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([notebookId, questionId])
  @@map("notebook_questions")
}

// Revisão espaçada (SM-2) das questões que o aluno errou
model QuestionReview {
  id           String    @id @default(uuid())
  userId       String
  questionId   String
  easeFactor   Float     @default(2.5)
  interval     Int       @default(1) // dias
  repetitions  Int       @default(0) // acertos seguidos na revisão
  lapses       Int       @default(0) // quantas vezes errou
  nextReviewAt DateTime
  lastReviewAt DateTime?
  mastered     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, mastered, nextReviewAt])
  @@map("question_reviews")
}

model QuestionComment {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  body       String   @db.Text
  likesCount Int      @default(0)
  isPinned   Boolean  @default(false) // "melhor comentário" fixado pela equipe
  createdAt  DateTime @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  likes    QuestionCommentLike[]

  @@index([questionId])
  @@map("question_comments")
}

model QuestionCommentLike {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment QuestionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("question_comment_likes")
}

model QuestionLog {
  id        String   @id @default(uuid())
  userId    String
  subjectId String
  topicId   String?
  source    String? // banca, prova, ano
  isCorrect Boolean
  timeSpent Int? // segundos
  notes     String?
  loggedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  topic   Topic?  @relation(fields: [topicId], references: [id])

  @@map("question_logs")
}

// ─── HÁBITOS ───────────────────────────────────────────────────────────────

model Habit {
  id          String         @id @default(uuid())
  userId      String
  name        String
  description String?
  frequency   HabitFrequency @default(DIARIO)
  targetDays  String? // JSON: [1,2,3,4,5] dias da semana
  streak      Int            @default(0)
  bestStreak  Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@map("habits")
}

model HabitCompletion {
  id          String   @id @default(uuid())
  habitId     String
  completedAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@map("habit_completions")
}

enum HabitFrequency {
  DIARIO
  SEMANAL
}

// ─── GAMIFICAÇÃO ───────────────────────────────────────────────────────────

model Gamification {
  id          String    @id @default(uuid())
  userId      String    @unique
  xp          Int       @default(0)
  level       Int       @default(1)
  streak      Int       @default(0)
  bestStreak  Int       @default(0)
  totalHours  Float     @default(0)
  badges      String?   @db.Text // JSON array de badges conquistados
  lastStudyAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gamification")
}

// ─── EMOÇÕES / ESTADO EMOCIONAL ────────────────────────────────────────────

model EmotionLog {
  id       String      @id @default(uuid())
  userId   String
  emotion  EmotionType
  energy   Int // 1-5
  notes    String?
  loggedAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emotion_logs")
}

enum EmotionType {
  MOTIVADO
  CANSADO
  ANSIOSO
  FOCADO
  ESTRESSADO
  TRANQUILO
}

// ─── NOTIFICAÇÕES ──────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  body      String
  type      NotificationType
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  LEMBRETE_ESTUDO
  META_ATINGIDA
  REVISAO_PENDENTE
  STREAK_RISCO
  SIMULADO
  SISTEMA
  INTELIGENCIA
  PROCRASTINACAO
  MISSAO
  MODO_GUERRA
  ENERGIA
  REDACAO
  PROFESSOR
}

// ═══════════════════════════════════════════════════════════════════════════
// ─── SISTEMA DE INTELIGÊNCIA ADAPTATIVA ────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

model BrainProfile {
  id                String       @id @default(uuid())
  userId            String       @unique
  energyPattern     Json         @default("{}")
  peakHours         Json         @default("[]")
  weakSubjects      Json         @default("[]")
  strongSubjects    Json         @default("[]")
  behaviorType      BehaviorType @default(INCONSISTENTE)
  performanceScore  Float        @default(0)
  retentionRate     Float        @default(0)
  forgettingIndex   Float        @default(0.5)
  consistencyScore  Float        @default(0)
  activeMode        StudyMode    @default(NORMAL)
  examDate          DateTime?
  avgSessionMinutes Float        @default(0)
  abandonmentRate   Float        @default(0)
  lastAnalyzedAt    DateTime?
  updatedAt         DateTime     @updatedAt
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brain_profiles")
}

enum BehaviorType {
  DISCIPLINADO
  PROCRASTINADOR
  ANSIOSO
  INCONSISTENTE
  GUERREIRO
}

enum StudyMode {
  NORMAL
  FORCA_BRUTA
  MODO_GUERRA
  RETORNO
  CANSADO
}

model BehaviorEvent {
  id         String            @id @default(uuid())
  userId     String
  type       BehaviorEventType
  subjectId  String?
  topicId    String?
  metadata   Json              @default("{}")
  occurredAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, occurredAt])
  @@map("behavior_events")
}

enum BehaviorEventType {
  TAREFA_INICIADA
  TAREFA_CONCLUIDA
  TAREFA_ABANDONADA
  TAREFA_PULADA
  SESSAO_INICIADA
  SESSAO_ENCERRADA
  INATIVIDADE_DETECTADA
  QUESTAO_RESPONDIDA
  FLASHCARD_REVISADO
  SIMULADO_INICIADO
  SIMULADO_CONCLUIDO
  MODO_FOCO_INICIADO
  FUGA_DETECTADA
  RETORNO_APOS_AUSENCIA
  BAIXO_DESEMPENHO
  ALTO_DESEMPENHO
  MISSAO_ACEITA
  MISSAO_CONCLUIDA
}

model EnergyLog {
  id          String    @id @default(uuid())
  userId      String
  level       Int
  hour        Int
  dayOfWeek   Int
  taskType    TaskType?
  performance Float?
  loggedAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, hour])
  @@map("energy_logs")
}

model DailyIntelligencePlan {
  id             String          @id @default(uuid())
  userId         String
  date           DateTime
  plan           Json
  replans        Json            @default("[]")
  status         DailyPlanStatus @default(GERADO)
  executionScore Float?
  dayMode        StudyMode       @default(NORMAL)
  generatedAt    DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_intelligence_plans")
}

enum DailyPlanStatus {
  GERADO
  EM_EXECUCAO
  REPLANEJADO
  CONCLUIDO
  ABANDONADO
}

model Mission {
  id              String        @id @default(uuid())
  userId          String
  title           String
  description     String        @db.Text
  type            MissionType
  criteria        Json
  xpReward        Int           @default(50)
  badge           String?
  progress        Json          @default("{}")
  status          MissionStatus @default(ATIVA)
  isAutoGenerated Boolean       @default(true)
  expiresAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("missions")
}

enum MissionType {
  FORCA_BRUTA
  CONSISTENCIA
  VELOCIDADE
  REVISAO
  SIMULADO_MISSAO
  RECUPERACAO
  MICRO_ACAO
  DESAFIO_DIARIO
  MODO_GUERRA
}

enum MissionStatus {
  ATIVA
  CONCLUIDA
  EXPIRADA
  RECUSADA
}

model BruteForceSession {
  id              String    @id @default(uuid())
  userId          String
  subjectId       String
  criticalTopics  Json
  trigger         String
  plannedDays     Int       @default(7)
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  isActive        Boolean   @default(true)
  improvementRate Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brute_force_sessions")
}

model ProcrastinationEvent {
  id                String              @id @default(uuid())
  userId            String
  type              ProcrastinationType
  avoidedSubject    String?
  avoidedTaskId     String?
  inactivityMinutes Int?
  systemAction      String?
  detectedAt        DateTime            @default(now())
  resolvedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("procrastination_events")
}

enum ProcrastinationType {
  INATIVIDADE_LONGA
  FUGA_MATERIA_DIFICIL
  LOOP_MATERIA_FACIL
  ABANDONO_SESSAO
  INICIO_TARDIO
}

model AnalysisInsight {
  id          String          @id @default(uuid())
  userId      String
  type        InsightType
  title       String
  body        String          @db.Text
  data        Json            @default("{}")
  severity    InsightSeverity @default(INFO)
  isRead      Boolean         @default(false)
  action      String?
  actionTaken Boolean         @default(false)
  generatedAt DateTime        @default(now())
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analysis_insights")
}

enum InsightType {
  PADRAO_ERRO
  HORARIO_PRODUTIVO
  QUEDA_DESEMPENHO
  ALTA_RETENCAO
  RISCO_ABANDONO
  FRAQUEZA_CRITICA
  SUGESTAO_REVISAO
  PROGRESSO_RAPIDO
  EFICIENCIA_HORARIA
}

enum InsightSeverity {
  INFO
  AVISO
  CRITICO
  POSITIVO
}

// ═══════════════════════════════════════════════════════════════════════════
// ─── SISTEMA DE MENTORIA HUMANA ─────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

model Mentor {
  id            String   @id @default(uuid())
  userId        String   @unique
  bio           String?  @db.Text
  specialties   Json     @default("[]")
  rating        Float    @default(0)
  totalStudents Int      @default(0)
  totalSessions Int      @default(0)
  isAvailable   Boolean  @default(true)
  pricePerHour  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mentorings Mentoring[]

  @@map("mentors")
}

model Mentoring {
  id        String          @id @default(uuid())
  studentId String
  mentorId  String
  status    MentoringStatus @default(PENDENTE)
  goals     Json            @default("[]")
  notes     String?         @db.Text
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  student  User                  @relation("StudentMentorings", fields: [studentId], references: [id], onDelete: Cascade)
  mentor   Mentor                @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  sessions MentoringSession[]
  messages MentoringMessage[]
  plans    MentoringWeeklyPlan[]

  @@map("mentorings")
}

enum MentoringStatus {
  PENDENTE
  ATIVA
  PAUSADA
  ENCERRADA
  RECUSADA
}

model MentoringSession {
  id           String        @id @default(uuid())
  mentoringId  String
  scheduledAt  DateTime
  durationMin  Int           @default(60)
  platform     String?
  meetUrl      String?
  status       SessionStatus @default(AGENDADA)
  notes        String?       @db.Text
  recordingUrl String?
  createdAt    DateTime      @default(now())

  mentoring Mentoring @relation(fields: [mentoringId], references: [id], onDelete: Cascade)

  @@map("mentoring_sessions")
}

enum SessionStatus {
  AGENDADA
  REALIZADA
  CANCELADA
  FALTOU
}

model MentoringMessage {
  id          String      @id @default(uuid())
  mentoringId String
  senderId    String
  content     String      @db.Text
  type        MessageType @default(TEXT)
  fileUrl     String?
  isRead      Boolean     @default(false)
  sentAt      DateTime    @default(now())

  mentoring Mentoring @relation(fields: [mentoringId], references: [id], onDelete: Cascade)
  sender    User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([mentoringId, sentAt])
  @@map("mentoring_messages")
}

enum MessageType {
  TEXT
  AUDIO
  FILE
  SYSTEM
}

model MentoringWeeklyPlan {
  id          String   @id @default(uuid())
  mentoringId String
  weekNumber  Int
  weekStart   DateTime
  weekEnd     DateTime
  goals       Json     @default("[]")
  tasks       Json     @default("[]")
  feedback    String?  @db.Text
  score       Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mentoring Mentoring @relation(fields: [mentoringId], references: [id], onDelete: Cascade)

  @@map("mentoring_weekly_plans")
}

// ═══════════════════════════════════════════════════════════════════════════
// ─── IMPORTAÇÃO DE EDITAL ───────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

model EditalImport {
  id            String       @id @default(uuid())
  userId        String
  fileName      String
  fileUrl       String?
  contestName   String?
  year          Int?
  status        EditalStatus @default(PROCESSANDO)
  extractedData Json         @default("{}")
  confirmedData Json?
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("edital_imports")
}

enum EditalStatus {
  PROCESSANDO
  EXTRAIDO
  AGUARDANDO_CONFIRMACAO
  CONFIRMADO
  ERRO
}

// ═══════════════════════════════════════════════════════════════════════════
// ─── DESAFIO DIÁRIO ─────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════════
// ─── SISTEMA DE REDAÇÃO COM PROFESSOR ───────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

model TeacherInvite {
  id        String    @id @default(uuid())
  studentId String
  token     String    @unique @default(uuid())
  expiresAt DateTime
  usedAt    DateTime?
  teacherId String?
  createdAt DateTime  @default(now())

  student User  @relation("StudentInvites", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User? @relation("TeacherUsedInvites", fields: [teacherId], references: [id])

  @@map("teacher_invites")
}

model TeacherStudent {
  id        String   @id @default(uuid())
  teacherId String
  studentId String
  isActive  Boolean  @default(true)
  linkedAt  DateTime @default(now())

  teacher User @relation("TeacherStudents", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("StudentTeachers", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
  @@map("teacher_students")
}

model Essay {
  id          String      @id @default(uuid())
  studentId   String
  title       String
  theme       String?
  content     String      @db.LongText
  pdfUrl      String?
  status      EssayStatus @default(PENDING)
  wordCount   Int?
  charCount   Int?
  version     Int         @default(1)
  parentId    String?
  submittedAt DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  student     User              @relation("StudentEssays", fields: [studentId], references: [id], onDelete: Cascade)
  corrections EssayCorrection[]
  comments    EssayComment[]
  parent      Essay?            @relation("EssayVersions", fields: [parentId], references: [id])
  versions    Essay[]           @relation("EssayVersions")

  @@index([studentId, status])
  @@map("essays")
}

enum EssayStatus {
  PENDING
  UNDER_REVIEW
  CORRECTED
  REWRITE_REQUESTED
  REWRITTEN
  ARCHIVED
}

model EssayCorrection {
  id                String    @id @default(uuid())
  essayId           String    @unique
  teacherId         String
  generalFeedback   String?   @db.Text
  strengthPoints    String?   @db.Text // pontos positivos
  improvementPoints String?   @db.Text // pontos a melhorar
  // Critérios ENEM (0-200 cada = 0-1000 total)
  scoreC1           Int? // Competência 1: Domínio da norma culta
  scoreC2           Int? // Competência 2: Compreensão da proposta
  scoreC3           Int? // Competência 3: Seleção de argumentos
  scoreC4           Int? // Competência 4: Coesão e coerência
  scoreC5           Int? // Competência 5: Proposta de intervenção
  totalScore        Int? // soma automática 0-1000
  audioUrl          String? // áudio gravado pelo professor
  correctedFileUrl  String? // PDF corrigido
  pdfAnnotations    String?   @db.LongText // JSON com rabiscos do professor por página
  requestRewrite    Boolean   @default(false)
  rewriteDeadline   DateTime?
  correctedAt       DateTime  @default(now())

  essay    Essay          @relation(fields: [essayId], references: [id], onDelete: Cascade)
  teacher  User           @relation("TeacherCorrections", fields: [teacherId], references: [id])
  comments EssayComment[]

  @@map("essay_corrections")
}

model EssayComment {
  id           String      @id @default(uuid())
  essayId      String
  correctionId String?
  authorId     String
  text         String      @db.Text
  selectedText String?     @db.Text // trecho do texto selecionado
  startOffset  Int? // posição inicial no conteúdo
  endOffset    Int? // posição final
  type         CommentType @default(ANNOTATION)
  isResolved   Boolean     @default(false)
  createdAt    DateTime    @default(now())

  essay      Essay            @relation(fields: [essayId], references: [id], onDelete: Cascade)
  correction EssayCorrection? @relation(fields: [correctionId], references: [id])
  author     User             @relation("EssayCommentAuthor", fields: [authorId], references: [id])

  @@index([essayId])
  @@map("essay_comments")
}

enum CommentType {
  ANNOTATION // anotação geral
  GRAMMAR // erro gramatical
  COHESION // coesão/coerência
  ARGUMENT // argumentação fraca
  SUGGESTION // sugestão de melhoria
  PRAISE // elogio / ponto positivo
}

model FeedbackTemplate {
  id         String   @id @default(uuid())
  teacherId  String
  title      String
  content    String   @db.Text
  category   String? // "gramatica", "coesao", "argumento", etc.
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("feedback_templates")
}

model DailyChallenge {
  id            String     @id @default(uuid())
  userId        String
  subjectId     String?
  question      String     @db.Text
  options       Json // ["A. ...", "B. ...", "C. ...", "D. ..."]
  correctOption String // "A", "B", "C" ou "D"
  explanation   String?    @db.Text
  difficulty    Difficulty @default(MEDIO)
  banca         String?
  userAnswer    String?
  isCorrect     Boolean?
  answeredAt    DateTime?
  timeSpent     Int?
  createdAt     DateTime   @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@index([userId, createdAt])
  @@map("daily_challenges")
}

// ─── PLANOS, ASSINATURAS E VENDAS ─────────────────────────────────────────

enum BillingPeriod {
  FREE
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  YEARLY
  LIFETIME
}

model Plan {
  id            String        @id @default(uuid())
  slug          String        @unique
  name          String
  tagline       String?
  description   String?       @db.Text
  priceCents    Int           @default(0)
  billingPeriod BillingPeriod @default(MONTHLY)
  features      Json // { recurso: true|false|número (limite) }
  color         String        @default("#F2B705")
  highlight     Boolean       @default(false) // "mais escolhido"
  isDefault     Boolean       @default(false) // plano de quem não assinou nada
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subscriptions Subscription[]
  orders        Order[]
  promotions    Promotion[]

  @@map("plans")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

model Subscription {
  id         String             @id @default(uuid())
  userId     String
  planId     String
  orderId    String?
  status     SubscriptionStatus @default(ACTIVE)
  source     String             @default("CHECKOUT") // CHECKOUT | ADMIN
  startedAt  DateTime           @default(now())
  expiresAt  DateTime?
  canceledAt DateTime?
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("subscriptions")
}

enum DiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id           String       @id @default(uuid())
  code         String       @unique
  description  String?
  discountType DiscountType @default(PERCENT)
  value        Int // % (1-100) ou centavos
  maxUses      Int? // null = ilimitado
  usedCount    Int          @default(0)
  perUserLimit Int          @default(1)
  planIds      Json? // restringe a planos (lista de ids); null = todos
  validFrom    DateTime?
  validUntil   DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  orders Order[]

  @@map("coupons")
}

model Promotion {
  id           String       @id @default(uuid())
  name         String
  description  String?
  badge        String? // ex.: "Black Friday"
  planId       String? // null = todos os planos pagos
  discountType DiscountType @default(PERCENT)
  value        Int
  startsAt     DateTime     @default(now())
  endsAt       DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  plan Plan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("promotions")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  planId        String
  couponId      String?
  promotionId   String?
  originalCents Int
  discountCents Int         @default(0)
  finalCents    Int
  status        OrderStatus @default(PENDING)
  paymentMethod String? // FREE | MANUAL | (gateway futuro)
  notes         String?     @db.Text
  paidAt        DateTime?
  createdAt     DateTime    @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   Plan    @relation(fields: [planId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("orders")
}

// Configurações globais editáveis pelo admin (ex.: liberar tudo para todos)
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// Árvore de matérias e assuntos (matéria › assunto › subassunto..., até 6 níveis).
// Os ids vêm do arquivo de origem e são estáveis: reimportar atualiza nomes sem perder vínculos.
model Assunto {
  id        Int      @id
  parentId  Int?
  name      String   @db.VarChar(255)
  path      String   @db.VarChar(64) // "001.002.001" — ordena e identifica a posição na árvore
  depth     Int // 1 = matéria
  createdAt DateTime @default(now())

  parent      Assunto?         @relation("AssuntoTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Assunto[]        @relation("AssuntoTree")
  questions   Question[]
  editalItems EditalItem[]
  laws        Law[]
  cycleItems  StudyCycleItem[]

  @@index([parentId])
  @@index([path])
  @@map("assuntos")
}

// Texto de apoio compartilhado por várias questões ("Leia o texto para responder às questões 1 a 5")
model QuestionText {
  id        String   @id @default(uuid())
  userId    String
  title     String? // ex.: "Texto I"
  body      String   @db.LongText // aceita a marcação de formatação (**negrito**, ==destaque==...)
  source    String?  @db.Text // autor, obra, veículo
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([isPublic])
  @@map("question_texts")
}

enum ReportType {
  ERRO_GABARITO
  ERRO_ENUNCIADO
  DESATUALIZADA
  PEDIDO_ANULACAO
  CLASSIFICACAO_ERRADA
  OUTRO
}

enum ReportStatus {
  ABERTO
  EM_ANALISE
  RESOLVIDO
  REJEITADO
}

// Aluno reporta problema na questão; admin analisa e responde
model QuestionReport {
  id         String       @id @default(uuid())
  questionId String
  userId     String
  type       ReportType
  message    String       @db.Text
  status     ReportStatus @default(ABERTO)
  adminReply String?      @db.Text
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([questionId])
  @@map("question_reports")
}

// ═══════════════════════════════════════════════════════════════════════════
// ─── EDITAL VERTICALIZADO ───────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

// Checklist do edital do aluno: cada tópico ligado (quando possível) a um nó da árvore de assuntos
model StudyEdital {
  id        String    @id @default(uuid())
  userId    String
  name      String
  banca     String?
  examDate  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items EditalItem[]

  @@index([userId])
  @@map("study_editais")
}

model EditalItem {
  id            String    @id @default(uuid())
  editalId      String
  discipline    String // matéria como escrita no edital
  label         String    @db.Text // tópico como escrito no edital
  assuntoId     Int?
  position      Int       @default(0)
  studied       Boolean   @default(false) // teoria vista
  reviews       Int       @default(0) // revisões feitas
  lastStudiedAt DateTime?
  notes         String?   @db.Text

  edital  StudyEdital @relation(fields: [editalId], references: [id], onDelete: Cascade)
  assunto Assunto?    @relation(fields: [assuntoId], references: [id], onDelete: SetNull)

  @@index([editalId, position])
  @@map("edital_items")
}

// ═══════════════════════════════════════════════════════════════════════════
// ─── LEI SECA ───────────────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

model Law {
  id          String   @id @default(uuid())
  title       String // "Constituição Federal de 1988"
  shortName   String // "CF/88"
  aliases     String?  @db.Text // termos que identificam a lei nas questões, separados por "|"
  description String?  @db.Text
  assuntoId   Int? // matéria da árvore (restringe a vinculação automática)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assunto  Assunto?     @relation(fields: [assuntoId], references: [id], onDelete: SetNull)
  articles LawArticle[]

  @@map("laws")
}

model LawArticle {
  id       String  @id @default(uuid())
  lawId    String
  number   String // "5", "37", "121-A"
  heading  String? @db.Text // título/capítulo/seção em que está
  text     String  @db.LongText
  position Int

  law        Law               @relation(fields: [lawId], references: [id], onDelete: Cascade)
  questions  QuestionLawLink[]
  highlights LawHighlight[]

  @@index([lawId, position])
  @@map("law_articles")
}

model QuestionLawLink {
  questionId String
  articleId  String
  auto       Boolean  @default(false) // vinculada pela leitura automática do texto
  createdAt  DateTime @default(now())

  question Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  article  LawArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([questionId, articleId])
  @@index([articleId])
  @@map("question_law_links")
}

// Marca-texto e nota do aluno em um artigo
model LawHighlight {
  id        String   @id @default(uuid())
  userId    String
  articleId String
  marks     Json // [{ start, end, color }]
  note      String?  @db.Text
  updatedAt DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  article LawArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@map("law_highlights")
}

// ═══════════════════════════════════════════════════════════════════════════
// ─── SIMULADOS COM RANKING ──────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

model Exam {
  id              String   @id @default(uuid())
  title           String
  description     String?  @db.Text
  banca           String?
  cargo           String?
  startsAt        DateTime // a partir de quando o aluno pode começar
  endsAt          DateTime // último momento para começar
  durationMinutes Int
  cutoffScore     Float? // nota de corte (em pontos líquidos)
  wrongPenalty    Boolean  @default(false) // uma errada anula uma certa (estilo Cebraspe)
  isPremium       Boolean  @default(false)
  isPublished     Boolean  @default(false)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  attempts  ExamAttempt[]

  @@index([isPublished, startsAt])
  @@map("exams")
}

model ExamQuestion {
  examId     String
  questionId String
  position   Int

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([examId, questionId])
  @@map("exam_questions")
}

model ExamAttempt {
  id         String    @id @default(uuid())
  examId     String
  userId     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  answers    Json // { questionId: letra }
  correct    Int       @default(0)
  wrong      Int       @default(0)
  blank      Int       @default(0)
  score      Float     @default(0)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@index([examId, finishedAt])
  @@map("exam_attempts")
}

// ═══════════════════════════════════════════════════════════════════════════
// ─── CICLO DE ESTUDOS ───────────────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════════════════════

model StudyCycle {
  id        String   @id @default(uuid())
  userId    String
  name      String
  isActive  Boolean  @default(true)
  round     Int      @default(1) // volta atual do ciclo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items StudyCycleItem[]
  logs  StudyTimeLog[]

  @@index([userId])
  @@map("study_cycles")
}

model StudyCycleItem {
  id          String @id @default(uuid())
  cycleId     String
  label       String
  assuntoId   Int?
  minutes     Int // meta da etapa em cada volta
  doneMinutes Int    @default(0) // estudado na volta atual
  position    Int
  color       String @default("#F2B705")

  cycle   StudyCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  assunto Assunto?       @relation(fields: [assuntoId], references: [id], onDelete: SetNull)
  logs    StudyTimeLog[]

  @@index([cycleId, position])
  @@map("study_cycle_items")
}

// Horas líquidas registradas pelo cronômetro (ou à mão)
model StudyTimeLog {
  id        String   @id @default(uuid())
  userId    String
  cycleId   String?
  itemId    String?
  label     String
  minutes   Int
  startedAt DateTime
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycle StudyCycle?     @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  item  StudyCycleItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@map("study_time_logs")
}
